
  mariadb:
    image: mariadb:11
    container_name: mariadb
    restart: unless-stopped
    environment:
      TZ: Asia/Tokyo
      MARIADB_ROOT_PASSWORD: rootpass_change_me
      MARIADB_DATABASE: miyaguchi_db
      MARIADB_USER: miyaguchi
      MARIADB_PASSWORD: miyaguchi
    ports:
      - "3306:3306"
    volumes:
      - mariadb_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mariadb-admin", "ping", "-h", "127.0.0.1", "-u", "root", "-prootpass_change_me"]
      interval: 10s
      timeout: 5s
      retries: 10

volumes:
  mariadb_data:
